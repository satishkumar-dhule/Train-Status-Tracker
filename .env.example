# Train-tracker environment reference.
#
# Copy to `.env` (API server) or `artifacts/train-tracker/.env` (SPA) and edit.
# Nothing here is required — every value has a safe default and telemetry is
# disabled unless an OTLP endpoint is configured.

# ---------------------------------------------------------------------------
# API server (artifacts/api-server) — OpenTelemetry
# ---------------------------------------------------------------------------
# Telemetry is DISABLED by default. It turns on when any of these is present:
#   OTEL_ENABLED=true, a non-empty OTEL_EXPORTER_OTLP_ENDPOINT /
#   OTEL_EXPORTER_OTLP_{TRACES,METRICS}_ENDPOINT, or an exporter in
#   OTEL_TRACES_EXPORTER / OTEL_METRICS_EXPORTER.
OTEL_ENABLED=false
# Base collector URL; traces go to {base}/v1/traces, metrics to {base}/v1/metrics.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Per-signal endpoints override the base.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Comma-separated k=v pairs sent as HTTP headers on export (e.g. auth tokens).
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
OTEL_SERVICE_NAME=train-tracker-api
# Deployment environment resource attribute (defaults to NODE_ENV).
# NODE_ENV=development
# service.version resource attribute (also returned by /api/healthz).
# SERVICE_VERSION=0.1.0
# Root span sample ratio in [0,1] (default 1).
# OTEL_TRACE_SAMPLE_RATIO=1
# Metric collection/export interval in ms (default 60000).
# OTEL_METRIC_EXPORT_INTERVAL_MS=60000
# Set to "false" to skip node auto-instrumentations (host/runtime/HTTP/Redis).
# OTEL_INSTRUMENTATIONS_ENABLED=true

# ---------------------------------------------------------------------------
# API server — app config
# ---------------------------------------------------------------------------
# PORT=5000
# REDIS_MODE=auto|manual|disabled  (default auto)
# REDIS_URL=redis://localhost:6379
# REDIS_COMMAND_TIMEOUT_MS=200
# REDIS_PROBE_INTERVAL_MS=900000
# REDIS_KEY_PREFIX=tt  # cache key prefix (`{prefix}:{train}:{date}`)
# CORS_ORIGIN=http://localhost:5173
# TRAIN_STATUS_PROVIDERS=paytm,goibibo,railyatri,whereismytrain,easemytrip,railradar,confirmtkt,redrail,ntes,erail,etrain,railmitra,runningstatus,trainspnrstatus,railbeeps
# RAILRADAR_API_KEY=  # enables the RailRadar provider
# INDIANRAILAPI_API_KEY=  # enables the IndianRailAPI provider (key-gated)
# TRAIN_DATA_URL=https://raw.githubusercontent.com/.../trains.json
# TRAIN_CATALOG_TTL_MS=3600000
# REDIS_GZIP=true
# Status cache: L2/upstream-shield TTL, L1 in-memory TTL, negative TTL, jitter
# spread in [0,1).
# STATUS_CACHE_TTL_MS=5000
# STATUS_CACHE_L1_TTL_MS=2000
# STATUS_CACHE_NEG_TTL_MS=1000
# STATUS_CACHE_TTL_JITTER=0.2
# Run-date cache: L2 TTL, L1 in-memory TTL, negative TTL, jitter spread, and the
# per-client runs budget per minute. Runs probes use their own key prefix
# (`tt:runs:v1` unless REDIS_KEY_PREFIX overrides it).
# RUNS_CACHE_TTL_MS=21600000
# RUNS_CACHE_L1_TTL_MS=300000
# RUNS_CACHE_NEG_TTL_MS=60000
# RUNS_CACHE_TTL_JITTER=0.1
# RUNS_RATE_LIMIT_PER_MIN=10

# ---------------------------------------------------------------------------
# SPA (artifacts/train-tracker) — RUM telemetry (Vite build-time env)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
# RUM telemetry is inert unless BOTH VITE_OTEL_ENABLED=true and an endpoint is set.
VITE_OTEL_ENABLED=false
# Base collector URL; metrics go to {base}/v1/metrics. When unset, metric export
# is skipped entirely (traces still work via the traces endpoint below).
# VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# VITE_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# VITE_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
VITE_OTEL_SERVICE_NAME=train-tracker-web
# VITE_OTEL_TRACE_SAMPLE_RATIO=1
# VITE_OTEL_ENABLE_INTERACTIONS=true
# Stale status is served from the client cache while younger than this (ms).
# VITE_STATUS_CACHE_TTL_MS=300000
# VITE_AUTO_REFRESH_INTERVAL_MS=30000
